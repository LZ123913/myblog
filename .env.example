# 拾光集博客系统环境变量
# 复制此文件为 .env 并填入实际值

# 服务端口
PORT=3000

# 运行环境。生产环境请设置为 production，避免开发验证码返回到接口
NODE_ENV=development
DEV_SHOW_OTP=false

# JWT 密钥（请更改为随机字符串）
JWT_SECRET=shiguang-blog-secret-key-change-me

# 数据库路径
DB_PATH=database/data/blog.db

# 邮件服务配置 (SMTP)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-password
SMTP_FROM=拾光集博客 <your-email@qq.com>

# AI 配置 - 通义千问 (DashScope)
AI_PROVIDER=qwen
AI_API_KEY=your-dashscope-api-key
AI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus

# 前端URL
CLIENT_URL=http://localhost:5173
